{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install and build portfolio",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Build portfolio",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Inspect Lucide exports",
			"type": "shell",
			"command": "node.exe",
			"args": [
				"-e",
				"import('lucide-react').then(m=>console.log(['Github','GithubIcon','Linkedin','LinkedinIcon','Code2','BriefcaseBusiness'].map(k=>k+':'+Boolean(m[k])).join('\\n')))"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build portfolio after photo update",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Start portfolio preview",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build portfolio with project screenshots",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}